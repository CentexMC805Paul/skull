// shift = true: ist der Kontext voll, wird nur die juengere Haelfte behalten und neu aufgebaut
define model M { dim = 16  context = 8  heads = 2 }
train M { data = "data/repeat.txt"  out = "data/shift.weights"  epochs = 40  rate = 0.01  batch = 2 }
generate M { weights = "data/shift.weights"  prompt = "das ist "  tokens = 60  temperature = 0  shift = true }
