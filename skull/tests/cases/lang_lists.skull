// Listen: Literale, Zugriff, Zuweisung, Anhaengen, Verketten, Referenz-Semantik, for-each
fails = 0
define func check(name, cond) {
    if not cond {
        print("FALSCH:", name)
        fails = fails + 1
    }
}

xs = [1, 2, 3,]
check("len", len(xs) == 3)
check("index", xs[0] == 1 and xs[2] == 3)
check("negativ", xs[-1] == 3 and xs[-3] == 1)
check("ausdruck als index", xs[len(xs) - 2] == 2 and xs[1 + 1] == 3)
check("leer", len([]) == 0 and [] == [] and not [])
check("nicht leer wahr", [0] and [[]])

push(xs, "a")
push(xs, [4, 5])
check("push", len(xs) == 5 and xs[3] == "a" and xs[4][1] == 5)
check("str", str(xs) == "[1, 2, 3, \"a\", [4, 5]]")
check("str leer", str([]) == "[]" and str([[]]) == "[[]]")
check("text + liste", "L:" + [1, "b"] == "L:[1, \"b\"]")

xs[1] = 20
xs[-1] = 0
check("zuweisung", xs[1] == 20 and xs[4] == 0)

// Referenz-Semantik: ys und xs sind dieselbe Liste
ys = xs
push(ys, 9)
check("alias", len(xs) == 6)
// Verketten legt eine neue Liste an
zs = xs + [7]
check("concat", len(zs) == 7 and len(xs) == 6 and zs[6] == 7)
cp = xs + []
cp[0] = 100
check("kopie", xs[0] == 1 and cp[0] == 100)

// Funktionen bekommen dieselbe Liste
define func anhaengen(l, v) { push(l, v) }
anhaengen(xs, "f")
check("funktion", xs[len(xs) - 1] == "f")

// verschachtelt
m = [[1, 2], [3, 4]]
m[1][0] = 99
check("verschachtelt", m[1][0] == 99 and m[0][1] == 2 and len(m[1]) == 2)
check("gleich", [1, [2, "x"]] == [1, [2, "x"]] and [1] != [1, 2] and [1, 2] != [2, 1])
check("typ", [1] != ["1"] and [1] != 1 and [] != "")

// pop
p = [1, 2, 3]
check("pop", pop(p) == 3 and len(p) == 2 and pop(p) == 2 and pop(p) == 1 and len(p) == 0)

// for-each
summe = 0
for x in [10, 20, 30] { summe = summe + x }
check("for-each", summe == 60)
n = 0
w = [1, 2, 3]
for x in w { push(w, x) }      // Durchlaeufe stehen beim Start fest
check("for-each wachsend", n == 0 and len(w) == 6)
t = ""
for c in "abc" { t = c + t }
check("for-each text", t == "cba")
for i in 1..3 { n = n + i }
check("for-bereich", n == 6)

// Listen in Funktionen und Rueckgabe
define func bereich(n) {
    r = []
    for i in 1..n { push(r, i * i) }
    return r
}
check("rueckgabe", bereich(4) == [1, 4, 9, 16] and bereich(4)[3] == 16)

// Zeilenumbruch vor '[': neue Anweisung, kein Index
q = len(xs)
[1, 2, 3]
check("kein index ueber zeilen", q == len(xs))

if fails == 0 { print("LISTEN OK") } else { print("LISTEN FEHLER:", fails) }
