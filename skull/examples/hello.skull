// hello.skull - Einfaches Beispiel für Grundfunktionen
// Verwendung: skull hello.skull

// Info anzeigen
skull_info()

// Variablen
define x = 42
define name = "Skull"

print("Hallo von", name)
print("x =", x)

// Mathematik
define a = 10
define b = 3
print("a + b =", a + b)
print("a * b =", a * b)

// Funktion
define func quadrat(n) {
    return n * n
}
print("quadrat(5) =", quadrat(5))

// Bedingung
if x > 10 {
    print("x ist groß")
} else {
    print("x ist klein")
}

// Schleife
print("Zahlen 1 bis 5:")
for i in 1..5 {
    print(i)
}

print("Fertig!")
